<Project Sdk="WixToolset.Sdk/6.0.2">

  <PropertyGroup>

    <InstallerPlatform>x64</InstallerPlatform>

    <!-- Текущая версия MSI -->
    <ProductVersion>1.0.1</ProductVersion>

    <OutputName>DomainPcInfo-x64-$(ProductVersion)</OutputName>

    <DefineConstants>
      PublishDir=$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64;
      ProductVersion=$(ProductVersion);
	  IconFile=$(MSBuildThisFileDirectory)..\..\src\DomainPcInfo\Assets\DomainPcInfo.ico
    </DefineConstants>

  </PropertyGroup>

</Project>
