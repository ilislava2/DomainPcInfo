<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="DomainPcInfo"
      Manufacturer="DomainPcInfo"
      Version="$(var.ProductVersion)"
      UpgradeCode="{7C74B261-57F4-4CC6-B805-86EB0EAF62D7}"
      Scope="perMachine">

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of DomainPcInfo is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Иконка для Windows Apps & Features и служебных ярлыков -->
    <Icon
        Id="DomainPcInfo.ico"
        SourceFile="$(var.IconFile)" />

    <Icon
        Id="DomainPcInfo.exe"
        SourceFile="$(var.IconFile)" /> 

    <Property
        Id="ARPPRODUCTICON"
        Value="DomainPcInfo.ico" />

    <!-- Основная программа -->
    <StandardDirectory Id="ProgramFiles6432Folder">

      <Directory
          Id="INSTALLFOLDER"
          Name="DomainPcInfo">

        <Component Id="DomainPcInfoComponent">

          <File
              Id="DomainPcInfoExe"
              Source="$(var.PublishDir)\DomainPcInfo.exe"
              KeyPath="yes">

            <!--
                Иконку здесь НЕ указываем.
                Ярлык автоматически использует иконку,
                встроенную в DomainPcInfo.exe.
            -->
            <Shortcut
                Id="DomainPcInfoStartMenuShortcut"
                Name="DomainPcInfo"
                Description="Информация о компьютере, домене, DC и сетевых интерфейсах"
                Directory="DomainPcInfoProgramMenuFolder"
                Advertise="yes"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DomainPcInfo.exe" />

          </File>

          <!-- Автозапуск -->
          <RegistryValue
              Root="HKLM"
              Key="Software\Microsoft\Windows\CurrentVersion\Run"
              Name="DomainPcInfo"
              Type="string"
              Value="&quot;[INSTALLFOLDER]DomainPcInfo.exe&quot;" />

        </Component>

      </Directory>

    </StandardDirectory>

    <!-- Меню Пуск -->
    <StandardDirectory Id="ProgramMenuFolder">

      <Directory
          Id="DomainPcInfoProgramMenuFolder"
          Name="DomainPcInfo">

        <Component Id="DomainPcInfoUninstallShortcutComponent">

          <Shortcut
              Id="DomainPcInfoUninstallShortcut"
              Name="Удалить DomainPcInfo"
              Description="Удалить DomainPcInfo"
              Target="[SystemFolder]msiexec.exe"
              Arguments="/x [ProductCode]"
              Icon="DomainPcInfo.ico" />

          <RemoveFolder
              Id="RemoveDomainPcInfoProgramMenuFolder"
              Directory="DomainPcInfoProgramMenuFolder"
              On="uninstall" />

          <RegistryValue
              Root="HKCU"
              Key="Software\DomainPcInfo"
              Name="UninstallShortcut"
              Type="integer"
              Value="1"
              KeyPath="yes" />

        </Component>

      </Directory>

    </StandardDirectory>

    <Feature
        Id="MainFeature"
        Title="DomainPcInfo"
        Level="1">

      <ComponentRef Id="DomainPcInfoComponent" />
      <ComponentRef Id="DomainPcInfoUninstallShortcutComponent" />

    </Feature>

  </Package>

</Wix>